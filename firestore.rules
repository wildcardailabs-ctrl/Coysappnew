rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }

    // Test connection endpoint
    match /test/connection {
      allow read: if true;
    }
    
    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying all users
      
      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == request.auth.uid
        && incoming().email is string
        && incoming().displayName is string
        && incoming().displayName.size() <= 100;
        
      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == request.auth.uid
        && incoming().email is string
        && incoming().displayName is string
        && incoming().displayName.size() <= 100;
        
      allow delete: if isOwner(userId) && isValidId(userId);
      
      // Match logs subcollection
      match /matches/{matchId} {
        allow read: if isOwner(userId);
        
        allow create: if isOwner(userId)
          && isValidId(matchId)
          && incoming().userId == request.auth.uid
          && incoming().opponent is string
          && incoming().opponent.size() <= 150;
          
        allow update: if isOwner(userId)
          && isValidId(matchId)
          && incoming().userId == request.auth.uid;
          
        allow delete: if isOwner(userId) && isValidId(matchId);
      }

      // Preferences subcollection
      match /preferences/{prefId} {
        allow read: if isOwner(userId);
        
        allow create, update: if isOwner(userId)
          && isValidId(prefId)
          && incoming().userId == request.auth.uid;
          
        allow delete: if isOwner(userId) && isValidId(prefId);
      }
    }
  }
}
