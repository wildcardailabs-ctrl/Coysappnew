# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FOOTBALL_DATA_API_KEY: Free Football-Data.org API token (https://www.football-data.org/client/register) for real Spurs fixtures, dates, scores & competition data
FOOTBALL_DATA_API_KEY=""

# SPORTMONKS_API_KEY: Sportmonks Football API v3 Token for live Spurs fixtures, scores, lineups & stats
SPORTMONKS_API_KEY=""

# GOOGLE_MAPS_API_KEY: Google Maps, Routes & Places API Key for live transport, navigation & pubs
VITE_GOOGLE_MAPS_API_KEY=""

# WEATHER_API_KEY: OpenWeatherMap or WeatherAPI key for live matchday pitch & stadium forecasts
WEATHER_API_KEY=""

# FIREBASE CONFIGURATION (For persistent Cloud Firestore, Auth & Storage)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# AFFILIATE PARTNERS
TRAINLINE_AFFILIATE_ID=""
BOOKING_AFFILIATE_ID=""
JUSTPARK_AFFILIATE_ID=""

